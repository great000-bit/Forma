# Public site URL, used for metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://forma.app

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic (server-only, never exposed to the browser)
ANTHROPIC_API_KEY=
# Optional model overrides
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_BUILD=claude-sonnet-5-5
