# Public site URL, used for metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://forma.app

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI provider: "gemini" or "anthropic". If unset, uses whichever key is set.
AI_PROVIDER=gemini
# Google AI Studio key (server-only, never exposed to the browser)
GEMINI_API_KEY=
# Anthropic key (server-only), if using Claude instead
ANTHROPIC_API_KEY=
# Optional model overrides for the active provider
# AI_MODEL_FAST=gemini-3.1-flash-lite
# AI_MODEL_BUILD=gemini-3.5-flash

# Portfolio links. Set to your root domain (e.g. forma.app) once wildcard DNS
# (*.forma.app) points at Vercel; until then links use /p/<name>.
# PORTFOLIO_ROOT_DOMAIN=forma.app

# Custom domains (Phase 8). A Vercel access token with access to this project,
# the project id (Project Settings > General) and the team id for team projects.
# Without these, domains are saved and DNS steps shown, but not attached.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Payments (Phase 9). Paystack secret key and the two plan codes made in the
# Paystack dashboard (Plans). Until these are set, Pro features stay unlocked
# for everyone and the upgrade buttons show "Payments open at launch".
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PLAN_MONTHLY=
# PAYSTACK_PLAN_YEARLY=
# Server-only Supabase key, used by the payment webhook to update plans.
# SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=
